     private RunUtils() {
     }
 
+    private static Boolean appKvmAccess = null;
+
+    /** True when this app can open /dev/kvm without su (downstream SELinux). */
+    public static boolean canAccessKvmWithoutRoot() {
+        if (appKvmAccess != null) return appKvmAccess;
+        try {
+            // /dev/kvm is world-accessible on AOSP; SELinux is what normally blocks apps.
+            // Downstream GrapheneOS policy allows droidvm_app to open it without su.
+            var kvm = new java.io.RandomAccessFile("/dev/kvm", "rw");
+            kvm.close();
+            appKvmAccess = true;
+        } catch (Exception e) {
+            appKvmAccess = false;
+        }
+        return appKvmAccess;
+    }
+
+    /** Prefer a normal shell when KVM works without root; keep su for rooted installs. */
+    @NonNull
+    public static String preferredShellBinary() {
+        if (Os.getuid() == 0 || canAccessKvmWithoutRoot())
+            return FileUtils.findExecute("sh", "/system/bin/sh");
+        return FileUtils.findExecute("su", "/system/bin/su");
+    }
+
     @NonNull
     private static RunContext getContext() {
-        return (Os.getuid() == 0) ?
-            SystemRunContext.getContext() :
-            RootRunContext.getContext();
+        if (Os.getuid() == 0)
+            return SystemRunContext.getContext();
+        // Prefer the app UID when SELinux already grants KVM access.
+        if (canAccessKvmWithoutRoot())
+            return SystemRunContext.getContext();
+        return RootRunContext.getContext();
     }
 
