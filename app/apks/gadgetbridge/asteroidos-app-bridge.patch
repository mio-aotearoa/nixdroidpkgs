+    private static String normalizeAppBridgeId(String id) {
+        if (CAMERA_WIRE_APP_ID.equals(id) || CAMERA_APP_ID.equals(id)) return CAMERA_APP_ID;
+        if (KEYBOARD_WIRE_APP_ID.equals(id) || KEYBOARD_APP_ID.equals(id)) return KEYBOARD_APP_ID;
+        if (VELA_WIRE_APP_ID.equals(id) || VELA_APP_ID.equals(id)) return VELA_APP_ID;
+        if (SYSTEM_WIRE_APP_ID.equals(id) || SYSTEM_APP_ID.equals(id)) return SYSTEM_APP_ID;
+        if (id != null && id.startsWith("org.asteroidos.") && id.length() <= AB_MAX_APP_LEN) return id;
+        return null;
+    }
+
+    private static String compactAppBridgeId(String canonical) {
+        if (CAMERA_APP_ID.equals(canonical)) return CAMERA_WIRE_APP_ID;
+        if (KEYBOARD_APP_ID.equals(canonical)) return KEYBOARD_WIRE_APP_ID;
+        if (VELA_APP_ID.equals(canonical)) return VELA_WIRE_APP_ID;
+        if (SYSTEM_APP_ID.equals(canonical)) return SYSTEM_WIRE_APP_ID;
+        return canonical;
+    }
