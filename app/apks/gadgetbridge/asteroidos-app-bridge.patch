+    private void handleSendToWatchIntent(Intent intent, BroadcastReceiver receiver) {
+        if (intent == null || !ACTION_SEND_TO_WATCH.equals(intent.getAction())) return;
+        if (!getDevice().isInitialized()) return;
+        final String appId = normalizeAppBridgeId(intent.getStringExtra(EXTRA_APP_ID));
+        final String path = intent.getStringExtra(EXTRA_ACTION);
+        final String payload = intent.getStringExtra(EXTRA_PAYLOAD);
+        final int msgType = intent.getIntExtra(EXTRA_MSG_TYPE, AB_MSG_MESSAGE);
+        if (appId == null || path == null || path.isEmpty() || path.length() > AB_MAX_PATH_LEN) return;
+
+        if (CAMERA_APP_ID.equals(appId)) {
+            if (!isSentFromCameraApp(receiver)) {
+                LOG.warn("AppBridge: dropping message not sent by {}", CAMERA_PACKAGE);
+                return;
+            }
+            if (msgType == AB_MSG_MESSAGE && !PHONE_TO_WATCH_ACTIONS.contains(path)) return;
+        }
+
+        final byte[] payloadBytes = payload != null ? payload.getBytes(StandardCharsets.UTF_8) : new byte[0];
+        if (payloadBytes.length > AB_MAX_PAYLOAD) return;
+
+        if (msgType == AB_MSG_DATA_PUT) {
+            getDataLayerPrefs().edit().putString(appId + "|" + path, payload != null ? payload : "").apply();
+        } else if (msgType == AB_MSG_DATA_DEL) {
+            getDataLayerPrefs().edit().remove(appId + "|" + path).apply();
+        }
+
+        final int flags = (msgType == AB_MSG_CHAN_DATA) ? (AB_FLAG_ACK_REQ | AB_FLAG_FIN) : AB_FLAG_NONE;
+        sendAppBridgeFrames(msgType, compactAppBridgeId(appId), path, payloadBytes, flags);
+    }
+
+    private void handleAppBridgeData(byte[] value) {
+        if (value == null || value.length < AB_HEADER_FIXED || value.length > APP_BRIDGE_MAX_PACKET) return;
+        if ((value[0] & 0xFF) != AB_MAGIC || (value[1] & 0xFF) != AB_VERSION) {
+            LOG.warn("AppBridge: unsupported header");
+            return;
+        }
+
+        final int msgType = value[2] & 0xFF;
+        final int flags = value[3] & 0xFF;
+        final int msgId = ((value[4] & 0xFF) << 8) | (value[5] & 0xFF);
+        final int seq = value[6] & 0xFF;
+        final int total = value[7] & 0xFF;
+
+        if (msgType == AB_MSG_ACK || msgType == AB_MSG_PONG) return;
+        if (msgType == AB_MSG_PING) {
+            sendAppBridgeControl(AB_MSG_PONG, msgId, Arrays.copyOfRange(value, AB_HEADER_FIXED, value.length));
+            return;
+        }
+        if (total == 0 || total > AB_MAX_CHUNKS || seq >= total) return;
+
+        int offset = 8;
+        final int appLen = value[offset++] & 0xFF;
+        if (appLen == 0 || appLen > AB_MAX_APP_LEN || value.length < offset + appLen + 1) return;
+        final String rawApp = new String(value, offset, appLen, StandardCharsets.UTF_8);
+        offset += appLen;
+
+        final int pathLen = value[offset++] & 0xFF;
+        if (pathLen == 0 || pathLen > AB_MAX_PATH_LEN || value.length < offset + pathLen) return;
+        final String path = new String(value, offset, pathLen, StandardCharsets.UTF_8);
+        offset += pathLen;
+
+        final String appId = normalizeAppBridgeId(rawApp);
+        if (appId == null) return;
+        final byte[] chunk = Arrays.copyOfRange(value, offset, value.length);
+
+        if (total == 1) {
+            if ((flags & AB_FLAG_ACK_REQ) != 0) sendAppBridgeControl(AB_MSG_ACK, msgId, new byte[0]);
+            dispatchAppBridgeDecoded(msgType, appId, path, chunk);
+            return;
+        }
+
+        synchronized (abReassembly) {
+            final long now = SystemClock.elapsedRealtime();
+            final Iterator<Map.Entry<Integer, AbReassembly>> it = abReassembly.entrySet().iterator();
+            while (it.hasNext()) {
+                if (now - it.next().getValue().createdMs > 10000L) it.remove();
+            }
+            AbReassembly st = abReassembly.get(msgId);
+            if (st == null) {
+                if (abReassembly.size() >= 8) return;
+                st = new AbReassembly(msgType, appId, path, total, (flags & AB_FLAG_ACK_REQ) != 0);
+                abReassembly.put(msgId, st);
+            }
+            if (st.total != total || st.msgType != msgType || !st.appId.equals(appId) || !st.path.equals(path)) return;
+            if (!st.seen[seq]) {
+                st.seen[seq] = true;
+                st.chunks[seq] = chunk;
+                st.received++;
+            }
+            if (st.received == st.total) {
+                final ByteArrayOutputStream bos = new ByteArrayOutputStream();
+                for (byte[] c : st.chunks) {
+                    if (c != null) bos.write(c, 0, c.length);
+                }
+                final boolean needAck = st.ackReq;
+                abReassembly.remove(msgId);
+                if (needAck) sendAppBridgeControl(AB_MSG_ACK, msgId, new byte[0]);
+                dispatchAppBridgeDecoded(msgType, appId, path, bos.toByteArray());
+            }
+        }
+    }
+
+    private void dispatchAppBridgeDecoded(int msgType, String appId, String path, byte[] payloadBytes) {
+        if (payloadBytes.length > AB_MAX_PAYLOAD) return;
+        final String payload = new String(payloadBytes, StandardCharsets.UTF_8);
+
+        if (msgType == AB_MSG_CAP_QUERY) {
+            try {
+                final JSONArray caps = new JSONArray();
+                caps.put("protocol_v2");
+                caps.put("keyboard_input");
+                caps.put("datalayer_v2");
+                caps.put("channel_stream");
+                caps.put("vela_interconnect");
+                if (isPackageInstalled(CAMERA_PACKAGE)) caps.put("camera_remote_v2");
+                final JSONObject obj = new JSONObject();
+                obj.put("version", AB_VERSION);
+                obj.put("capabilities", caps);
+                sendAppBridgeFrames(AB_MSG_CAP_RESP, SYSTEM_WIRE_APP_ID, "/capabilities",
+                        obj.toString().getBytes(StandardCharsets.UTF_8), AB_FLAG_NONE);
+            } catch (JSONException e) {
+                LOG.warn("AppBridge: failed to encode capabilities", e);
+            }
+            return;
+        }
+        if (msgType == AB_MSG_DATA_PUT) {
+            getDataLayerPrefs().edit().putString(appId + "|" + path, payload).apply();
+            broadcastAppBridge(msgType, appId, path, payload, null);
+            return;
+        }
+        if (msgType == AB_MSG_DATA_DEL) {
+            getDataLayerPrefs().edit().remove(appId + "|" + path).apply();
+            broadcastAppBridge(msgType, appId, path, "", null);
+            return;
+        }
+        if (msgType == AB_MSG_DATA_GET) {
+            final SharedPreferences prefs = getDataLayerPrefs();
+            final String key = appId + "|" + path;
+            if (prefs.contains(key)) {
+                final String val = prefs.getString(key, "");
+                sendAppBridgeFrames(AB_MSG_DATA_PUT, compactAppBridgeId(appId), path,
+                        val.getBytes(StandardCharsets.UTF_8), AB_FLAG_NONE);
+            }
+            return;
+        }
+        if (msgType == AB_MSG_CHAN_DATA) {
+            broadcastAppBridge(msgType, appId, path, payload, null);
+            return;
+        }
+        if (msgType != AB_MSG_MESSAGE) return;
+
+        if (KEYBOARD_APP_ID.equals(appId)) {
+            if ("request_input".equals(path) || "open".equals(path)) {
+                showKeyboardInputNotification(payload);
+            } else if ("close".equals(path)) {
+                cancelKeyboardInputNotification();
+            }
+            return;
+        }
+        if (CAMERA_APP_ID.equals(appId)) {
+            if (!WATCH_TO_PHONE_ACTIONS.contains(path)) return;
+            broadcastAppBridge(msgType, CAMERA_APP_ID, path, payload, CAMERA_PACKAGE);
+            return;
+        }
+        broadcastAppBridge(msgType, appId, path, payload, null);
+    }
+
+    private void broadcastAppBridge(int msgType, String appId, String path, String payload, String targetPkg) {
+        final Intent broadcast = new Intent(ACTION_RECEIVE_FROM_WATCH)
+                .putExtra(EXTRA_MSG_TYPE, msgType)
+                .putExtra(EXTRA_APP_ID, appId)
+                .putExtra(EXTRA_ACTION, path)
+                .putExtra(EXTRA_PAYLOAD, payload);
+        if (targetPkg != null) broadcast.setPackage(targetPkg);
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE) {
+            final Bundle options = BroadcastOptions.makeBasic()
+                    .setShareIdentityEnabled(true)
+                    .toBundle();
+            getContext().sendBroadcast(broadcast, APP_BRIDGE_PERMISSION, options);
+        } else {
+            getContext().sendBroadcast(broadcast, APP_BRIDGE_PERMISSION);
+        }
+    }
+
+    private synchronized void sendAppBridgeFrames(int msgType, String wireAppId, String path, byte[] payload, int flags) {
+        final byte[] appBytes = wireAppId.getBytes(StandardCharsets.UTF_8);
+        final byte[] pathBytes = path.getBytes(StandardCharsets.UTF_8);
+        final int headerOverhead = AB_HEADER_FIXED + appBytes.length + pathBytes.length;
+        final int maxChunk = Math.min(AB_CHUNK_SIZE, APP_BRIDGE_MAX_PACKET - headerOverhead);
+        if (maxChunk <= 0) return;
+        final int total = Math.max(1, (payload.length + maxChunk - 1) / maxChunk);
+        if (total > AB_MAX_CHUNKS) return;
+
+        final int msgId = abNextMsgId++;
+        if (abNextMsgId > 0xFFFF) abNextMsgId = 1;
+
+        final TransactionBuilder builder = createTransactionBuilder("sendAppBridgeFrames");
+        for (int seq = 0; seq < total; seq++) {
+            final int start = seq * maxChunk;
+            final int len = Math.min(maxChunk, Math.max(0, payload.length - start));
+            final int chunkFlags = (seq == total - 1) ? flags : (flags & ~AB_FLAG_FIN);
+            final byte[] packet = new byte[headerOverhead + len];
+            int idx = 0;
+            packet[idx++] = (byte) AB_MAGIC;
+            packet[idx++] = (byte) AB_VERSION;
+            packet[idx++] = (byte) msgType;
+            packet[idx++] = (byte) chunkFlags;
+            packet[idx++] = (byte) ((msgId >> 8) & 0xFF);
+            packet[idx++] = (byte) (msgId & 0xFF);
+            packet[idx++] = (byte) seq;
+            packet[idx++] = (byte) total;
+            packet[idx++] = (byte) appBytes.length;
+            System.arraycopy(appBytes, 0, packet, idx, appBytes.length);
+            idx += appBytes.length;
+            packet[idx++] = (byte) pathBytes.length;
+            System.arraycopy(pathBytes, 0, packet, idx, pathBytes.length);
+            idx += pathBytes.length;
+            if (len > 0) System.arraycopy(payload, start, packet, idx, len);
+            safeWriteToCharacteristic(builder, AsteroidOSConstants.APP_BRIDGE_RX_CHAR, packet);
+        }
+        builder.queue();
+    }
+
+    private void sendAppBridgeControl(int msgType, int msgId, byte[] payload) {
+        final int len = payload != null ? Math.min(payload.length, APP_BRIDGE_MAX_PACKET - AB_HEADER_FIXED) : 0;
+        final byte[] packet = new byte[AB_HEADER_FIXED + len];
+        packet[0] = (byte) AB_MAGIC;
+        packet[1] = (byte) AB_VERSION;
+        packet[2] = (byte) msgType;
+        packet[3] = (byte) AB_FLAG_NONE;
+        packet[4] = (byte) ((msgId >> 8) & 0xFF);
+        packet[5] = (byte) (msgId & 0xFF);
+        packet[6] = 0;
+        packet[7] = 1;
+        packet[8] = 0;
+        packet[9] = 0;
+        if (len > 0) System.arraycopy(payload, 0, packet, AB_HEADER_FIXED, len);
+        final TransactionBuilder builder = createTransactionBuilder("sendAppBridgeControl");
+        safeWriteToCharacteristic(builder, AsteroidOSConstants.APP_BRIDGE_RX_CHAR, packet);
+        builder.queue();
+    }
+
