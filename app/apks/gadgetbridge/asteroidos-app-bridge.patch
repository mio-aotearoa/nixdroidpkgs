+    private static final class AbReassembly {
+        final int msgType;
+        final String appId;
+        final String path;
+        final int total;
+        final boolean ackReq;
+        final byte[][] chunks;
+        final boolean[] seen;
+        final long createdMs;
+        int received = 0;
+
+        AbReassembly(int msgType, String appId, String path, int total, boolean ackReq) {
+            this.msgType = msgType;
+            this.appId = appId;
+            this.path = path;
+            this.total = total;
+            this.ackReq = ackReq;
+            this.chunks = new byte[total][];
+            this.seen = new boolean[total];
+            this.createdMs = SystemClock.elapsedRealtime();
+        }
+    }
