+    private void ingestAsteroidHealthSummary(String payload) {
+        try {
+            final JSONObject obj = new JSONObject(payload);
+            final int fallbackTs = obj.optInt("updated", (int) (System.currentTimeMillis() / 1000L));
+            int hrTs = fallbackTs;
+            int hrBpm = 0;
+            final String latestHr = obj.optString("latestHr", "");
+            if (!latestHr.isEmpty()) {
+                final String[] p = latestHr.split(":");
+                if (p.length >= 2) {
+                    hrTs = Integer.parseInt(p[0]);
+                    hrBpm = Integer.parseInt(p[1]);
+                }
+            }
+
+            int stepsTs = fallbackTs;
+            int stepsVal = 0;
+            final String latestSteps = obj.optString("latestSteps", "");
+            if (!latestSteps.isEmpty()) {
+                final String[] p = latestSteps.split(":");
+                if (p.length >= 2) {
+                    stepsTs = Integer.parseInt(p[0]);
+                    stepsVal = Integer.parseInt(p[1]);
+                }
+            }
+
+            int sleepTs = fallbackTs;
+            int sleepStage = -1;
+            int sleepBpm = 0;
+            final String latestSleep = obj.optString("latestSleep", "");
+            if (!latestSleep.isEmpty()) {
+                final String[] p = latestSleep.split(":");
+                if (p.length >= 2) {
+                    sleepTs = Integer.parseInt(p[0]);
+                    sleepStage = Integer.parseInt(p[1]);
+                    if (p.length >= 4) {
+                        sleepBpm = Integer.parseInt(p[3]);
+                    }
+                }
+            }
+
+            final int sampleTs = Math.max(fallbackTs, Math.max(hrTs, Math.max(stepsTs, sleepTs)));
+            final int bpm = sleepBpm > 0 ? sleepBpm : hrBpm;
+            final ActivityKind kind;
+            switch (sleepStage) {
+                case 0:
+                    kind = ActivityKind.AWAKE_SLEEP;
+                    break;
+                case 1:
+                    kind = ActivityKind.LIGHT_SLEEP;
+                    break;
+                case 2:
+                    kind = ActivityKind.DEEP_SLEEP;
+                    break;
+                case 3:
+                    kind = ActivityKind.REM_SLEEP;
+                    break;
+                default:
+                    kind = stepsVal > 0 ? ActivityKind.ACTIVITY : ActivityKind.UNKNOWN;
+                    break;
+            }
+
+            try (DBHandler dbHandler = GBApplication.acquireDB()) {
+                final AsteroidOSSampleProvider provider = new AsteroidOSSampleProvider(getDevice(), dbHandler.getDaoSession());
+                final AsteroidOSActivitySample sample = provider.createActivitySample();
+                sample.setDevice(DBHelper.getDevice(getDevice(), dbHandler.getDaoSession()));
+                sample.setUser(DBHelper.getUser(dbHandler.getDaoSession()));
+                sample.setTimestamp(sampleTs);
+                sample.setRawKind(kind.getCode());
+                sample.setSteps(Math.max(0, stepsVal));
+                sample.setHeartRate(bpm > 0 ? bpm : ActivitySample.NOT_MEASURED);
+                provider.upsertSample(sample);
+            }
+
+            final Intent intent = new Intent(GBApplication.ACTION_NEW_DATA)
+                    .putExtra(GBDevice.EXTRA_DEVICE, getDevice());
+            LocalBroadcastManager.getInstance(getContext()).sendBroadcast(intent);
+        } catch (Exception e) {
+            LOG.warn("AsteroidOS: failed to ingest health summary", e);
+        }
+    }
+
