+    private static int alignToMinute(int epochSec) {
+        return (epochSec / 60) * 60;
+    }
+
+    private void ingestAsteroidHealthSummary(String payload) {
+        try {
+            final JSONObject obj = new JSONObject(payload);
+            final String date = obj.optString("date", "");
+
+            final SharedPreferences prefs = getDataLayerPrefs();
+            final String rawAddress = getDevice().getAddress();
+            final String deviceKey = (rawAddress != null && !rawAddress.isEmpty()) ? rawAddress : "default";
+            final String hrTsKey = "health_hr_ts|" + deviceKey;
+            final String stepsDateKey = "health_steps_date|" + deviceKey;
+            final String stepsTsKey = "health_steps_ts|" + deviceKey;
+            final String stepsTotalKey = "health_steps_total|" + deviceKey;
+            final String sleepSigKey = "health_sleep_sig|" + deviceKey;
+
+            final int lastHrTs = prefs.getInt(hrTsKey, 0);
+            int maxHrTs = lastHrTs;
+            final List<int[]> hrBatch = new ArrayList<>();
+            final JSONArray hrSamples = obj.optJSONArray("hrSamples");
+            if (hrSamples != null && hrSamples.length() > 0) {
+                for (int i = 0; i < hrSamples.length(); i++) {
+                    final JSONArray pair = hrSamples.optJSONArray(i);
+                    if (pair == null || pair.length() < 2) continue;
+                    final int ts = pair.optInt(0, 0);
+                    final int bpm = pair.optInt(1, 0);
+                    if (ts > maxHrTs && bpm >= 1 && bpm <= 300 && bpm != 255) {
+                        hrBatch.add(new int[]{alignToMinute(ts), bpm});
+                        maxHrTs = ts;
+                    }
+                }
+            } else {
+                final String latestHr = obj.optString("latestHr", "");
+                if (!latestHr.isEmpty()) {
+                    final String[] p = latestHr.split(":");
+                    if (p.length >= 2) {
+                        try {
+                            final int hrTs = Integer.parseInt(p[0].trim());
+                            final int hrBpm = Integer.parseInt(p[1].trim());
+                            if (hrTs > maxHrTs && hrBpm >= 1 && hrBpm <= 300 && hrBpm != 255) {
+                                hrBatch.add(new int[]{alignToMinute(hrTs), hrBpm});
+                                maxHrTs = hrTs;
+                            }
+                        } catch (NumberFormatException e) {
+                            LOG.warn("AsteroidOS: invalid latestHr '{}'", latestHr, e);
+                        }
+                    }
+                }
+            }
+            final boolean ingestHr = !hrBatch.isEmpty();
+
+            String curStepsDate = prefs.getString(stepsDateKey, "");
+            int curStepsTs = prefs.getInt(stepsTsKey, 0);
+            int curStepsTotal = prefs.getInt(stepsTotalKey, -1);
+            boolean hasNewStepsRecord = false;
+            final List<int[]> stepBatch = new ArrayList<>();
+            final JSONArray stepSamples = obj.optJSONArray("stepSamples");
+            if (stepSamples != null && stepSamples.length() > 0) {
+                for (int i = 0; i < stepSamples.length(); i++) {
+                    final JSONArray pair = stepSamples.optJSONArray(i);
+                    if (pair == null || pair.length() < 2) continue;
+                    final int ts = pair.optInt(0, 0);
+                    final int total = pair.optInt(1, -1);
+                    if (ts <= curStepsTs || total < 0) continue;
+                    final int delta;
+                    if (!date.isEmpty() && date.equals(curStepsDate) && curStepsTotal >= 0) {
+                        delta = total >= curStepsTotal ? (total - curStepsTotal) : total;
+                    } else {
+                        delta = total;
+                    }
+                    if (delta > 0) {
+                        stepBatch.add(new int[]{alignToMinute(ts), delta});
+                    }
+                    curStepsDate = date;
+                    curStepsTs = ts;
+                    curStepsTotal = total;
+                    hasNewStepsRecord = true;
+                }
+            } else {
+                final String latestSteps = obj.optString("latestSteps", "");
+                if (!latestSteps.isEmpty()) {
+                    final String[] p = latestSteps.split(":");
+                    if (p.length >= 2) {
+                        try {
+                            final int stepsTs = Integer.parseInt(p[0].trim());
+                            final int stepsTotal = Integer.parseInt(p[1].trim());
+                            if (stepsTs > curStepsTs && stepsTotal >= 0) {
+                                final int delta;
+                                if (!date.isEmpty() && date.equals(curStepsDate) && curStepsTotal >= 0) {
+                                    delta = stepsTotal >= curStepsTotal ? (stepsTotal - curStepsTotal) : stepsTotal;
+                                } else {
+                                    delta = stepsTotal;
+                                }
+                                if (delta > 0) {
+                                    stepBatch.add(new int[]{alignToMinute(stepsTs), delta});
+                                }
+                                curStepsDate = date;
+                                curStepsTs = stepsTs;
+                                curStepsTotal = stepsTotal;
+                                hasNewStepsRecord = true;
+                            }
+                        } catch (NumberFormatException e) {
+                            LOG.warn("AsteroidOS: invalid latestSteps '{}'", latestSteps, e);
+                        }
+                    }
+                }
+            }
+            final boolean ingestSteps = !stepBatch.isEmpty();
+
+            int sleepTs = 0;
+            int sleepState = -1;
+            final String latestSleep = obj.optString("latestSleep", "");
+            if (!latestSleep.isEmpty()) {
+                final String[] p = latestSleep.split(":");
+                // Only accept 2-field sleep/wake states (<epoch_sec>:<0|1>) from van Hees (2015/2018) detector;
+                // ignore legacy 4-field unvalidated stage records.
+                if (p.length == 2) {
+                    try {
+                        sleepTs = Integer.parseInt(p[0].trim());
+                        sleepState = Integer.parseInt(p[1].trim());
+                    } catch (NumberFormatException e) {
+                        LOG.warn("AsteroidOS: invalid latestSleep '{}'", latestSleep, e);
+                    }
+                }
+            }
+
+            final JSONArray sleepSegments = obj.optJSONArray("sleepSegments");
+            final boolean hasSleepSegments = sleepSegments != null && sleepSegments.length() > 0;
+            final String serializedSleepSegments = hasSleepSegments ? sleepSegments.toString() : null;
+            final String prevSleepSig = prefs.getString(sleepSigKey, null);
+            final boolean ingestSleepSegments = hasSleepSegments && !serializedSleepSegments.equals(prevSleepSig);
+            final int singleSleepTs = alignToMinute(sleepTs);
+            final int singleSleepState = sleepState;
+            final boolean ingestSingleSleep = !hasSleepSegments && sleepTs > 0 && (singleSleepState == 0 || singleSleepState == 1);
+            final boolean[] ingestedAnySleep = new boolean[]{false};
+
+            if (ingestHr || ingestSteps || ingestSleepSegments || ingestSingleSleep) {
+                try (DBHandler dbHandler = GBApplication.acquireDB()) {
+                    final AsteroidOSSampleProvider provider = new AsteroidOSSampleProvider(getDevice(), dbHandler.getDaoSession());
+                    final nodomain.freeyourgadget.gadgetbridge.entities.Device dbDevice =
+                            DBHelper.getDevice(getDevice(), dbHandler.getDaoSession());
+                    final nodomain.freeyourgadget.gadgetbridge.entities.User dbUser =
+                            DBHelper.getUser(dbHandler.getDaoSession());
+
+                    // Batch all upserts in a single SQLite transaction; all timestamps are minute-aligned
+                    // so SleepSessionSegmenter merges HR/steps cleanly with SLEEP_ANY/AWAKE_SLEEP rows.
+                    dbHandler.getDaoSession().runInTx(() -> {
+                        if (ingestSleepSegments) {
+                            for (int i = 0; i < sleepSegments.length(); i++) {
+                                final JSONArray seg = sleepSegments.optJSONArray(i);
+                                if (seg == null || seg.length() < 3) continue;
+                                final int segStart = alignToMinute(seg.optInt(0, 0));
+                                final int segMinutes = seg.optInt(1, 0);
+                                final int segState = seg.optInt(2, -1);
+                                if (segStart <= 0 || segMinutes <= 0 || segMinutes > 1440 || (segState != 0 && segState != 1)) {
+                                    continue;
+                                }
+                                final int rawKind = (segState == 1 ? ActivityKind.SLEEP_ANY : ActivityKind.AWAKE_SLEEP).getCode();
+                                for (int m = 0; m < segMinutes; m++) {
+                                    final int ts = segStart + m * 60;
+                                    final AsteroidOSActivitySample sleepSample = provider.createActivitySample();
+                                    sleepSample.setDevice(dbDevice);
+                                    sleepSample.setUser(dbUser);
+                                    sleepSample.setTimestamp(ts);
+                                    sleepSample.setRawKind(rawKind);
+                                    sleepSample.setSteps(0);
+                                    sleepSample.setHeartRate(ActivitySample.NOT_MEASURED);
+                                    ingestedAnySleep[0] |= provider.upsertSample(sleepSample);
+                                }
+                            }
+                        } else if (ingestSingleSleep) {
+                            final AsteroidOSActivitySample sleepSample = provider.createActivitySample();
+                            sleepSample.setDevice(dbDevice);
+                            sleepSample.setUser(dbUser);
+                            sleepSample.setTimestamp(singleSleepTs);
+                            sleepSample.setRawKind((singleSleepState == 1 ? ActivityKind.SLEEP_ANY : ActivityKind.AWAKE_SLEEP).getCode());
+                            sleepSample.setSteps(0);
+                            sleepSample.setHeartRate(ActivitySample.NOT_MEASURED);
+                            ingestedAnySleep[0] = provider.upsertSample(sleepSample);
+                        }
+                        for (int[] pair : hrBatch) {
+                            final AsteroidOSActivitySample hrSample = provider.createActivitySample();
+                            hrSample.setDevice(dbDevice);
+                            hrSample.setUser(dbUser);
+                            hrSample.setTimestamp(pair[0]);
+                            hrSample.setRawKind(ActivityKind.UNKNOWN.getCode());
+                            hrSample.setSteps(0);
+                            hrSample.setHeartRate(pair[1]);
+                            provider.upsertSample(hrSample);
+                        }
+                        for (int[] pair : stepBatch) {
+                            final AsteroidOSActivitySample stepSample = provider.createActivitySample();
+                            stepSample.setDevice(dbDevice);
+                            stepSample.setUser(dbUser);
+                            stepSample.setTimestamp(pair[0]);
+                            stepSample.setRawKind(ActivityKind.ACTIVITY.getCode());
+                            stepSample.setSteps(pair[1]);
+                            stepSample.setHeartRate(ActivitySample.NOT_MEASURED);
+                            provider.upsertSample(stepSample);
+                        }
+                    });
+                }
+            }
+
+            if (ingestHr || hasNewStepsRecord || ingestSleepSegments) {
+                final SharedPreferences.Editor editor = prefs.edit();
+                if (ingestHr) {
+                    editor.putInt(hrTsKey, maxHrTs);
+                }
+                if (hasNewStepsRecord) {
+                    editor.putString(stepsDateKey, curStepsDate);
+                    editor.putInt(stepsTsKey, curStepsTs);
+                    editor.putInt(stepsTotalKey, curStepsTotal);
+                }
+                if (ingestSleepSegments) {
+                    editor.putString(sleepSigKey, serializedSleepSegments);
+                }
+                editor.apply();
+            }
+
+            if (ingestHr || ingestSteps || ingestedAnySleep[0]) {
+                final Intent intent = new Intent(GBApplication.ACTION_NEW_DATA)
+                        .putExtra(GBDevice.EXTRA_DEVICE, getDevice());
+                LocalBroadcastManager.getInstance(getContext()).sendBroadcast(intent);
+            }
+        } catch (Exception e) {
+            LOG.warn("AsteroidOS: failed to ingest health summary", e);
+        }
+    }
